STT_PROVIDER=mock
WHISPER_MODEL_PATH=/models/whisper-large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ko
WHISPER_PREPROCESS_AUDIO=true
WHISPER_INITIAL_PROMPT=국민권익위원회 상담 통화입니다. 민원, 접수번호, 담당 부서, 처리 상태를 정확히 전사하세요.
WHISPER_HOTWORDS=국민권익위원회, 민원, 접수번호, 담당 부서, 처리 상태, 상담원
WHISPER_CONDITION_ON_PREVIOUS_TEXT=false
WHISPER_VAD_THRESHOLD=0.35
WHISPER_MIN_SILENCE_DURATION_MS=500
WHISPER_SPEECH_PAD_MS=400
ANALYSIS_PROVIDER=mock
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_CONTEXT_WINDOW=32768
OLLAMA_MAX_INPUT_CHARS=40000
DATABASE_PATH=storage/acrc_call_log.db
UPLOAD_DIR=storage/uploads
PROCESSED_DIR=storage/processed
MAX_UPLOAD_BYTES=104857600
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

